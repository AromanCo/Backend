# Generate fresh independent random values. Never use these placeholders in a running app.
MIGRATOR_DB_PASSWORD=replace-with-long-random-value
APP_DB_PASSWORD=replace-with-another-long-random-value
DATABASE_URL=postgresql+psycopg://aroman_migrator:replace-with-long-random-value@localhost:5432/aroman
OTP_PEPPER=replace-with-32-or-more-random-characters
SESSION_PEPPER=replace-with-a-different-32-or-more-random-characters
ENVIRONMENT=development
SMS_PROVIDER=unconfigured
FAKE_SMS_ENABLED=false
CORS_ORIGINS=http://localhost:3000
TRUSTED_PROXY_CIDRS=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
MAX_CONCEPT_NOTES=6
